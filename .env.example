AI_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Voice uses the same API key. These defaults can be overridden.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
# Optional: absolute path to a writable directory for saved scenario JSON files.
# SCENARIO_DATA_DIR=C:/path/to/scenarios
# Live speech-to-speech (scoring continues to use OPENAI_MODEL)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Netlify sessions automatically use shared temporary Blobs storage.
# SESSION_STORAGE=netlify can explicitly select it with a Netlify runtime context.
